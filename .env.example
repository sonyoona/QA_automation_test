# STAFF 관리자 사이트
STAFF_URL=

# 정상 로그인 가능 계정 (전체 기능)
STAFF_ADMIN_EMAIL=adminyoona@a1mobilsoft.com
STAFF_ADMIN_PASSWORD=

# 로그인 권한이 없는 계정 (TC-103 실패 케이스용, 업체 대표권한)
STAFF_NOAUTH_EMAIL=testyoona@a1mobilsoft.com
STAFF_NOAUTH_PASSWORD=

# 데이터를 바꾸는 테스트(@pytest.mark.mutating - TC-059~066 차량 업체 이관) 허용 여부.
# 평소에는 비워 둔다. 없으면 그 8건은 setup 단계에서 스스로 skip 한다.
#
# ★ 한 번 돌리려고 여기를 고칠 필요는 없다. 그때는 명령에 플래그를 붙인다.
#       pytest -m mutating --allow-mutating -v
#   플래그는 그 명령 한 줄에만 살아서 끄는 것을 잊을 수가 없다. 여기에 true 를 적으면
#   지울 때까지 남으므로, CI 처럼 매번 붙이기 어려운 자리에서만 쓴다.
ALLOW_MUTATING_TESTS=
#
# ★ 켜도 STAFF_URL 이 아는 dev 주소가 아니면 mutating 은 막힌다 (conftest.py 의
#   MUTATING_ALLOWED_HOSTS). 운영 주소를 몰라도 안전하도록 화이트리스트로 뒀다.
