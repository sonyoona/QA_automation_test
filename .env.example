# STAFF 관리자 사이트
STAFF_URL=

# 정상 로그인 가능 계정 (전체 기능)
STAFF_ADMIN_EMAIL=adminyoona@a1mobilsoft.com
STAFF_ADMIN_PASSWORD=

# 로그인 권한이 없는 계정 (TC-103 실패 케이스용, 업체 대표권한)
STAFF_NOAUTH_EMAIL=testyoona@a1mobilsoft.com
STAFF_NOAUTH_PASSWORD=

# 데이터를 바꾸는 테스트(@pytest.mark.mutating - TC-059~066 차량 업체 이관)를 켤 때만 true.
# 없으면 그 8건은 setup 단계에서 스스로 skip 한다. 기본값이 "안 함" 인 것이 요점이라,
# 평소에는 비워 두고 필요할 때만 켠 뒤 다시 지운다.
ALLOW_MUTATING_TESTS=
